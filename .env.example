# Copie para .env.local (desenvolvimento) ou cadastre no painel da Vercel (produção).
# NUNCA commite o arquivo com valores reais.

# Obrigatória: string de conexão do PostgreSQL (ex.: Neon).
DATABASE_URL=postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=require

# Opcional: use "false" somente para um PostgreSQL local sem SSL.
# DATABASE_SSL=false
